<Window x:Class="SubtitleCompare.App.FfmpegMissingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FFmpeg is required"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBg}"
        SourceInitialized="OnSourceInitialized">
    <StackPanel Margin="24,22,24,24">
        <TextBlock Text="FFmpeg was not found"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource EqualFg}"/>
        <TextBlock Margin="0,10,0,0"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource EqualFg}"
                   Text="Subtitle Compare uses FFmpeg to read subtitle tracks from MKV files. Install it, then you can drop a file."/>
        <TextBlock Margin="0,16,0,4"
                   FontSize="12"
                   Foreground="{DynamicResource MutedFg}"
                   Text="This is the command (Windows Package Manager):"/>
        <DockPanel>
            <Button x:Name="CopyButton" Content="Copy" Click="OnCopyClick"
                    DockPanel.Dock="Right" Margin="8,0,0,0" MinWidth="72"/>
            <TextBox x:Name="CommandBox"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     FontFamily="Consolas"
                     FontSize="12"
                     Padding="8,6"
                     VerticalContentAlignment="Center"/>
        </DockPanel>
        <TextBlock Margin="0,10,0,0"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource MutedFg}"
                   Text="Install FFmpeg opens a console so you can watch winget. When it finishes, press a key in that window."/>
        <TextBlock x:Name="StatusText"
                   Margin="0,12,0,0"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource MutedFg}"/>
        <DockPanel Margin="0,18,0,0" LastChildFill="False">
            <Button x:Name="CloseButton" Content="Close" Click="OnCloseClick"
                    DockPanel.Dock="Right" MinWidth="88"/>
            <Button x:Name="InstallButton" Content="Install FFmpeg" Click="OnInstallClick"
                    DockPanel.Dock="Right" Margin="0,0,8,0" MinWidth="120"/>
        </DockPanel>
    </StackPanel>
</Window>
