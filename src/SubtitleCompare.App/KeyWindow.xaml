<Window x:Class="SubtitleCompare.App.KeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Key"
        Width="400" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBg}"
        SourceInitialized="OnSourceInitialized">
    <StackPanel Margin="22,16,22,18">
        <TextBlock Margin="0,0,0,12"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource MutedFg}"
                   Text="Rows line up by overlapping timestamps, not cue numbers."/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="88"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Grid.Column="0"
                    Background="{DynamicResource RowBg}"
                    Padding="8,5"
                    Margin="0,0,10,8"
                    CornerRadius="3"
                    VerticalAlignment="Top">
                <TextBlock FontSize="13">
                    <Run Text="hello" Foreground="{DynamicResource EqualFg}"/>
                </TextBlock>
            </Border>
            <TextBlock Grid.Row="0" Grid.Column="1"
                       Margin="0,4,0,8"
                       FontSize="12.5"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource EqualFg}"
                       Text="Same in every track — no highlight"/>

            <Border Grid.Row="1" Grid.Column="0"
                    Background="{DynamicResource RowBg}"
                    Padding="8,5"
                    Margin="0,0,10,8"
                    CornerRadius="3"
                    VerticalAlignment="Top">
                <TextBlock FontSize="13">
                    <Run Text="well"
                         Foreground="{DynamicResource EqualFg}"
                         Background="{DynamicResource ChangedBg}"/>
                </TextBlock>
            </Border>
            <TextBlock Grid.Row="1" Grid.Column="1"
                       Margin="0,4,0,8"
                       FontSize="12.5"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource EqualFg}"
                       Text="Changed — yellow: this word is in the other track(s) but the wording differs"/>

            <Border Grid.Row="2" Grid.Column="0"
                    Background="{DynamicResource RowBg}"
                    Padding="8,5"
                    Margin="0,0,10,8"
                    CornerRadius="3"
                    VerticalAlignment="Top">
                <TextBlock FontSize="13">
                    <Run Text="doing"
                         Foreground="{DynamicResource EqualFg}"
                         Background="{DynamicResource UniqueBg}"/>
                </TextBlock>
            </Border>
            <TextBlock Grid.Row="2" Grid.Column="1"
                       Margin="0,4,0,8"
                       FontSize="12.5"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource EqualFg}"
                       Text="Only here — green: this word is not in the other track(s)"/>

            <Border Grid.Row="3" Grid.Column="0"
                    Background="{DynamicResource MissingBg}"
                    Margin="0,0,10,0"
                    CornerRadius="3"
                    VerticalAlignment="Top">
                <DockPanel>
                    <Border Width="3"
                            Background="{DynamicResource MissingAccent}"
                            DockPanel.Dock="Left"
                            CornerRadius="3,0,0,3"/>
                    <TextBlock Text="no cue"
                               FontSize="12"
                               FontStyle="Italic"
                               Foreground="{DynamicResource MissingFg}"
                               VerticalAlignment="Center"
                               Margin="8,5,8,5"/>
                </DockPanel>
            </Border>
            <TextBlock Grid.Row="3" Grid.Column="1"
                       Margin="0,4,0,0"
                       FontSize="12.5"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource EqualFg}"
                       Text="No cue — muted row: this track has nothing at that time"/>
        </Grid>

        <Button Content="Close"
                HorizontalAlignment="Right"
                Margin="0,18,0,0"
                MinWidth="80"
                IsDefault="True"
                IsCancel="True"
                Click="OnCloseClick"/>
    </StackPanel>
</Window>
