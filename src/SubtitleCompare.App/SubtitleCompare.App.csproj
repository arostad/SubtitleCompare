<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SubtitleCompare</AssemblyName>
    <RootNamespace>SubtitleCompare.App</RootNamespace>
    <ApplicationTitle>Subtitle Compare</ApplicationTitle>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.1.28</Version>
    <InformationalVersion>1.1.28</InformationalVersion>
    <AssemblyVersion>1.1.28.0</AssemblyVersion>
    <FileVersion>1.1.28.0</FileVersion>
    <Authors>Andy Rostad</Authors>
    <Company>Andy Rostad</Company>
    <Copyright>Copyright © 2026 Andy Rostad. MIT License.</Copyright>
    <Description>MKV subtitle comparison tool</Description>
    <Product>Subtitle Compare</Product>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SubtitleCompare.Core\SubtitleCompare.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Tesseract" Version="5.2.0" GeneratePathProperty="true" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\app.png" />
  </ItemGroup>
  <!-- Native Tesseract/Leptonica are extracted on first OCR; do not bake tessdata into the exe. -->
  <Target Name="EmbedTesseractNatives" BeforeTargets="PrepareForBuild">
    <ItemGroup Condition="Exists('$(PkgTesseract)\x64\tesseract50.dll')">
      <EmbeddedResource Include="$(PkgTesseract)\x64\tesseract50.dll">
        <LogicalName>tesseract50.dll</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="$(PkgTesseract)\x64\leptonica-1.82.0.dll">
        <LogicalName>leptonica-1.82.0.dll</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>
</Project>
