<Window x:Class="SubtitleCompare.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Subtitle Compare"
        Icon="pack://application:,,,/Assets/app.png"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="640"
        Background="{DynamicResource AppBg}"
        AllowDrop="True"
        Drop="OnWindowDrop"
        DragOver="OnWindowDragOver"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        SourceInitialized="OnSourceInitialized"
        Closed="OnWindowClosed">
    <DockPanel>
        <Border x:Name="FfmpegBanner"
                DockPanel.Dock="Top"
                Background="{DynamicResource BannerBg}"
                BorderBrush="{DynamicResource BannerBorder}"
                BorderThickness="0,0,0,1"
                Padding="14,8"
                Visibility="Collapsed">
            <TextBlock x:Name="FfmpegBannerText"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource BannerFg}"
                       FontSize="13"/>
        </Border>

        <Border x:Name="UpdateBanner"
                DockPanel.Dock="Top"
                Background="{DynamicResource BannerBg}"
                BorderBrush="{DynamicResource BannerBorder}"
                BorderThickness="0,0,0,1"
                Padding="10,7"
                Visibility="Collapsed">
            <DockPanel>
                <Button x:Name="UpdateNowButton" Content="Update" Click="OnUpdateNowClick"
                        DockPanel.Dock="Right" Margin="8,0,0,0"/>
                <Button x:Name="UpdateLaterButton" Content="Later" Click="OnUpdateLaterClick"
                        DockPanel.Dock="Right" Margin="8,0,0,0"/>
                <TextBlock x:Name="UpdateBannerText"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource BannerFg}"
                           FontSize="13"
                           Text="A new version is available."/>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Top" Padding="10,8"
                Background="{DynamicResource ChromeBg}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <Button x:Name="OpenButton" Content="Open…" Click="OnOpenClick" DockPanel.Dock="Left"/>
                <Button x:Name="PrevDiffButton" Content="Previous difference" Click="OnPrevDiffClick" DockPanel.Dock="Left" IsEnabled="False"/>
                <Button x:Name="NextDiffButton" Content="Next difference" Click="OnNextDiffClick" DockPanel.Dock="Left" IsEnabled="False"/>
                <Button x:Name="ThemeToggleButton"
                        Click="OnThemeToggleClick"
                        DockPanel.Dock="Right"
                        Padding="7,4"
                        Margin="0"
                        MinWidth="32"
                        ToolTip="Switch to dark theme">
                    <Grid Width="16" Height="16">
                        <Canvas x:Name="ThemeSunGlyph" Visibility="Collapsed">
                            <Ellipse Canvas.Left="5" Canvas.Top="5" Width="6" Height="6"
                                     Fill="{DynamicResource ButtonFg}"/>
                            <Path Stroke="{DynamicResource ButtonFg}"
                                  StrokeThickness="1.3"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M8,1.3 L8,3.1 M8,12.9 L8,14.7 M1.3,8 L3.1,8 M12.9,8 L14.7,8 M3.2,3.2 L4.5,4.5 M11.5,11.5 L12.8,12.8 M12.8,3.2 L11.5,4.5 M4.5,11.5 L3.2,12.8"/>
                        </Canvas>
                        <Canvas x:Name="ThemeMoonGlyph">
                            <Path Fill="{DynamicResource ButtonFg}"
                                  Data="M10.4,1.6 C6.2,2.4 3.4,5.8 3.4,9.6 C3.4,13.4 6.6,16.4 10.6,16.4 C8.2,15.4 6.6,12.8 6.6,10 C6.6,6.8 8.4,3.8 10.4,1.6 Z"/>
                        </Canvas>
                    </Grid>
                </Button>
                <Button x:Name="AboutButton" Content="About" Click="OnAboutClick" DockPanel.Dock="Right" Margin="8,0,8,0"/>
                <Button x:Name="KeyButton" Content="Key" Click="OnKeyClick" DockPanel.Dock="Right"
                        Margin="0" ToolTip="How differences are shown."/>
                <TextBlock Margin="16,0,8,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedFg}"
                           Text="Drop an MKV to compare subtitle tracks  ·  Ctrl+O open  ·  F7 / F8 jump differences"/>
            </DockPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Padding="8,3">
            <StatusBarItem>
                <TextBlock x:Name="StatusExtract" Text="Ready" Foreground="{DynamicResource MutedFg}"/>
            </StatusBarItem>
            <Separator x:Name="StatusOcrSep" Visibility="Collapsed"/>
            <StatusBarItem x:Name="StatusOcrTextItem" Visibility="Collapsed" Width="200">
                <TextBlock x:Name="StatusOcrText"
                           FontFamily="Consolas, Cascadia Mono, Courier New"
                           Foreground="{DynamicResource MutedFg}"/>
            </StatusBarItem>
            <StatusBarItem x:Name="StatusOcrItem" Visibility="Collapsed" Width="140">
                <ProgressBar x:Name="StatusOcrBar" Height="8"
                             Minimum="0" Maximum="100"
                             Foreground="{DynamicResource SelectedBorder}"
                             Background="{DynamicResource ScrollTrack}"/>
            </StatusBarItem>
            <Separator x:Name="StatusErrorSep" Visibility="Collapsed"/>
            <StatusBarItem>
                <TextBlock x:Name="StatusError" Text="" Foreground="{DynamicResource ErrorFg}"/>
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="10">
            <Border x:Name="EmptyState"
                    BorderBrush="{DynamicResource EmptyDash}"
                    BorderThickness="2"
                    CornerRadius="8"
                    Background="{DynamicResource EmptyBg}">
                <Grid>
                    <Rectangle Stroke="{DynamicResource EmptyDash}" StrokeThickness="2" StrokeDashArray="6 4" RadiusX="8" RadiusY="8" Margin="-2"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Drop an MKV here to compare subtitle tracks"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource EmptyFg}"/>
                        <TextBlock Margin="0,10,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource MutedFg}"
                                   TextAlignment="Center"
                                   Text="Accepts .mkv, .mka, .mks, and .mp4 / .m4v when they contain subtitles.&#x0a;Three panes line up the same moment so you can diff wording track-by-track."/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="LoadedState" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="SlotA" Grid.Row="0" Grid.Column="0"
                          SelectionChanged="OnSlotSelectionChanged"/>
                <ComboBox x:Name="SlotB" Grid.Row="0" Grid.Column="2"
                          SelectionChanged="OnSlotSelectionChanged"/>
                <ComboBox x:Name="SlotC" Grid.Row="0" Grid.Column="4"
                          SelectionChanged="OnSlotSelectionChanged"/>

                <TextBlock x:Name="HintA" Grid.Row="1" Grid.Column="0"
                           Margin="2,4,2,0" FontSize="11"
                           Foreground="{DynamicResource MutedFg}"
                           TextWrapping="Wrap" Visibility="Collapsed"/>
                <TextBlock x:Name="HintB" Grid.Row="1" Grid.Column="2"
                           Margin="2,4,2,0" FontSize="11"
                           Foreground="{DynamicResource MutedFg}"
                           TextWrapping="Wrap" Visibility="Collapsed"/>
                <TextBlock x:Name="HintC" Grid.Row="1" Grid.Column="4"
                           Margin="2,4,2,0" FontSize="11"
                           Foreground="{DynamicResource MutedFg}"
                           TextWrapping="Wrap" Visibility="Collapsed"/>

                <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5"
                        Background="{DynamicResource PanelBg}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <Grid>
                        <ScrollViewer x:Name="CompareScroll"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="0"
                                      Background="{DynamicResource AltRowBg}">
                            <Grid x:Name="CompareGrid" Margin="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </ScrollViewer>

                        <Grid x:Name="PaneOverlays" IsHitTestVisible="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="OverlayA" Grid.Column="0" Visibility="Collapsed"
                                    Background="{DynamicResource OverlayBg}" Margin="4">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16" MaxWidth="280">
                                    <TextBlock x:Name="OverlayAText" TextWrapping="Wrap"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               FontFamily="Consolas, Cascadia Mono, Courier New"
                                               Foreground="{DynamicResource MutedFg}"/>
                                    <ProgressBar x:Name="OverlayABar" Height="8" Width="180" Margin="0,12,0,0"
                                                 Minimum="0" Maximum="100" Visibility="Collapsed"
                                                 Foreground="{DynamicResource SelectedBorder}"
                                                 Background="{DynamicResource ScrollTrack}"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="OverlayB" Grid.Column="2" Visibility="Collapsed"
                                    Background="{DynamicResource OverlayBg}" Margin="4">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16" MaxWidth="280">
                                    <TextBlock x:Name="OverlayBText" TextWrapping="Wrap"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               FontFamily="Consolas, Cascadia Mono, Courier New"
                                               Foreground="{DynamicResource MutedFg}"/>
                                    <ProgressBar x:Name="OverlayBBar" Height="8" Width="180" Margin="0,12,0,0"
                                                 Minimum="0" Maximum="100" Visibility="Collapsed"
                                                 Foreground="{DynamicResource SelectedBorder}"
                                                 Background="{DynamicResource ScrollTrack}"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="OverlayC" Grid.Column="4" Visibility="Collapsed"
                                    Background="{DynamicResource OverlayBg}" Margin="4">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16" MaxWidth="280">
                                    <TextBlock x:Name="OverlayCText" TextWrapping="Wrap"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               FontFamily="Consolas, Cascadia Mono, Courier New"
                                               Foreground="{DynamicResource MutedFg}"/>
                                    <ProgressBar x:Name="OverlayCBar" Height="8" Width="180" Margin="0,12,0,0"
                                                 Minimum="0" Maximum="100" Visibility="Collapsed"
                                                 Foreground="{DynamicResource SelectedBorder}"
                                                 Background="{DynamicResource ScrollTrack}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
